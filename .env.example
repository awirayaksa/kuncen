# Shared by both services. Copy to .env and source it, or set these in the
# systemd units under deploy/.

# The one piece of state. Both processes open the same file (WAL mode).
KUNCEN_DB=/opt/kuncen/data/kuncen.db

# --- what Kuncen guards ------------------------------------------------------
# Read by both services. The lock, the queue and the timers do not care what is
# behind the proxy, so this is the only place the resource is named.
KUNCEN_RESOURCE_NAME=DGX Spark
# Article used in sentences: "the DGX Spark is free". Leave empty for names
# that stand on their own, e.g. KUNCEN_RESOURCE_NAME=Build Server 3.
KUNCEN_RESOURCE_ARTICLE=the

# --- kuncen-proxy -------------------------------------------------------------
KUNCEN_PROXY_PORT=8080
KUNCEN_PROXY_HOST=0.0.0.0
# vLLM. This MUST be a loopback address: enforcement is a property of the
# network, not of our code. If vLLM binds 0.0.0.0 the lock is decorative.
KUNCEN_UPSTREAM=http://127.0.0.1:8000
# Only if you started vLLM with --api-key. Never a user's kuncen key.
# KUNCEN_UPSTREAM_API_KEY=
# Printed in 423 bodies so a blocked tool tells you where to go.
KUNCEN_DASHBOARD_URL=http://spark.local:3000
KUNCEN_TICK_MS=1000
# Health probe path. vLLM serves /health; OpenAI-compatible gateways usually do
# not and serve /v1/models instead. Leave unset to try both and stick with
# whichever answers. Set explicitly to pin one, or to `off` to stop probing.
# KUNCEN_HEALTH_PATH=/v1/models
KUNCEN_HEALTH_POLL_MS=5000
# KUNCEN_HEALTH_TIMEOUT_MS=5000

# --- request tracing ---------------------------------------------------------
# OFF BY DEFAULT, and read by both services. `full` makes kuncen-proxy write
# every request and response body it relays to disk, and puts them on the
# dashboard at /traces: authors read their own, admins read anyone's.
#
# This reverses the project's usual rule that bodies are never logged. Everyone
# using the box is recorded, so it is announced in the proxy log at startup and
# on the dashboard while it is on. Turning it on needs a restart of both
# services; there is deliberately no runtime toggle.
# KUNCEN_TRACE=full
# Defaults to `traces/` beside KUNCEN_DB. Bodies are files, not database rows:
# an agentic client resends its whole context every turn, and multi-MB writes
# into kuncen.db would land in the same WAL the 1s sweeper transacts on.
# KUNCEN_TRACE_DIR=/opt/kuncen/data/traces
# Per body, per request. Past this the body stops being recorded and the trace
# is flagged as truncated; the request itself is never affected.
# KUNCEN_TRACE_MAX_BYTES=8388608
# Pruned by kuncen-proxy every 5 minutes. Files go before rows.
# KUNCEN_TRACE_RETENTION_HOURS=168

# --- kuncen-web ---------------------------------------------------------------
KUNCEN_WEB_PORT=3000
KUNCEN_WEB_HOST=0.0.0.0
# Shown on the profile page as the base URL to paste into tools.
KUNCEN_PROXY_URL=http://spark.local:8080
# Set to 1 only if you put kuncen-web behind TLS.
KUNCEN_SECURE_COOKIES=0
